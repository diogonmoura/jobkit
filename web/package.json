{
  "name": "jobkit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build:docx": "node scripts/build-docx-bundle.mjs",
    "predeploy": "npm run build:docx && npm run build:sql",
    "test": "tsx --test src/*.test.ts src/scan/*.test.ts",
    "build:sql": "node scripts/build-setup-sql.mjs",
    "predev": "npm run build:sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.109.0",
    "docx": "^9.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22"
  }
}
